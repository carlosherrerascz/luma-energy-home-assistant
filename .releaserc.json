{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", {"changelogFile": "CHANGELOG.md"}],
    ["@semantic-release/exec", {"prepareCmd": "node scripts/set-version.js ${nextRelease.version}"}],
    ["@semantic-release/github", {"assets": [{"path": "dist/luma-energy-home-assistant.zip", "label": "HACS package"}]}],
    ["@semantic-release/git", {"assets": ["CHANGELOG.md", "custom_components/luma_energy/manifest.json"], "message": "chore(release): ${nextRelease.version} [skip ci]"}]
  ]
}
